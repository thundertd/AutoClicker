<?xml version="1.0" encoding="utf-8"?>
<!-- Layout cho hành động vuốt -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="100dp">

    <!-- Mũi tên màu đỏ -->
    <ImageView
        android:id="@+id/arrowView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/arrow_red"
        android:scaleType="fitXY" />

    <!-- Điểm bắt đầu (xanh lá đậm) -->
    <FrameLayout
        android:id="@+id/startPoint"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true">

        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_green_dark" />
    </FrameLayout>

    <!-- Điểm kết thúc (xanh lá có viền + số) -->
    <FrameLayout
        android:id="@+id/endPoint"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true">

        <View
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_green_border" />

        <TextView
            android:id="@+id/tvSwipeNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

</RelativeLayout>
